FROM maven:3.9.9-eclipse-temurin-17 AS build

WORKDIR /workspace
COPY . .

ARG MODULE
ARG ARTIFACT
RUN --mount=type=cache,id=12307-maven-repo,target=/root/.m2 mvn -B -ntp -Dmaven.wagon.http.retryHandler.count=5 -pl "${MODULE}" -am -DskipTests package

FROM eclipse-temurin:17-jre-jammy

WORKDIR /app
ARG MODULE
ARG ARTIFACT
COPY --from=build /workspace/${MODULE}/target/${ARTIFACT} /app/app.jar

EXPOSE 9000
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
